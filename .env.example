PORT=3000

DB_USER=postgres
DB_HOST=localhost
DB_NAME=App
DB_PASSWORD=
DB_PORT=5432

GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

PYTHON_AI_URL=http://127.0.0.1:5000/predict

# Firebase Admin SDK 服務帳戶金鑰路徑（SOS 推播通知用）。從 Firebase Console → 專案設定 →
# 服務帳戶 → 產生新的私密金鑰 下載，預設放在 secrets/firebase-adminsdk.json 就不用設定這個值；
# 這個檔案不進版本控制（見 .gitignore 的 secrets/）
FIREBASE_SERVICE_ACCOUNT_PATH=

# 寄送 email 驗證碼用的 Gmail 帳號。GMAIL_APP_PASSWORD 不是登入密碼，是 Google 帳戶設定 →
# 安全性 →應用程式密碼 產生的 16 碼專用密碼（需先開啟兩步驟驗證才看得到這個選項）。
# 沒設定的話，伺服器仍會正常啟動，只是不會寄出驗證信。
GMAIL_USER=
GMAIL_APP_PASSWORD=
