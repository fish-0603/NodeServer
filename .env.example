PORT=3000

DB_USER=postgres
DB_HOST=localhost
DB_NAME=App
DB_PASSWORD=
DB_PORT=5432

GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

PYTHON_AI_URL=http://127.0.0.1:5000/predict

# Firebase Admin SDK 服務帳戶金鑰路徑（SOS 推播通知用）。從 Firebase Console → 專案設定 →
# 服務帳戶 → 產生新的私密金鑰 下載，預設放在 secrets/firebase-adminsdk.json 就不用設定這個值；
# 這個檔案不進版本控制（見 .gitignore 的 secrets/）
FIREBASE_SERVICE_ACCOUNT_PATH=
